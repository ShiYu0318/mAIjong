# Backend
DATABASE_URL=sqlite:///data/maijong.db
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
# Room snapshots + pub/sub; each backend instance needs its own INSTANCE_ID
# REDIS_URL=redis://localhost:6379/0
# INSTANCE_ID=default
# S3_ENDPOINT= S3_BUCKET= S3_ACCESS_KEY= S3_SECRET_KEY=
# Address browsers use for replay downloads when it differs from S3_ENDPOINT
# (docker compose: backend uses http://s3:8333, browsers http://localhost:8333)
# S3_PUBLIC_ENDPOINT=
# HINT_LLM_PROVIDER=  HINT_LLM_API_KEY=  HINT_LLM_MODEL=  HINT_LLM_BASE_URL=
# REPLAY_DIR=data/replays
# TOKEN_TTL_HOURS=168
# RECONNECT_WINDOW_SEC=300

# Competition: admin endpoints (season rollover, manual arena match) need this header value
# ADMIN_TOKEN=change-me
# Play a rated agent arena match every N seconds (unset = only on request)
# ARENA_INTERVAL=60
# Optional Celery for lab jobs (otherwise an in-process pool is used)
# CELERY_BROKER_URL=redis://localhost:6379/1
# LAB_WORKERS=2
# With a Celery beat, hands never replay-verified are re-run every N seconds (0 = off)
# REPLAY_VERIFY_INTERVAL=3600

# Monitoring: GET /metrics (Prometheus text format); set a token to require
# "Authorization: Bearer <token>"
# METRICS_TOKEN=change-me
# Error tracking (needs `uv pip install sentry-sdk`)
# SENTRY_DSN=  SENTRY_ENVIRONMENT=production  SENTRY_TRACES_SAMPLE_RATE=0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
# Browser error tracking (build time)
# NEXT_PUBLIC_SENTRY_DSN=  NEXT_PUBLIC_SENTRY_ENVIRONMENT=production

# Rate limits (per IP / per socket)
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_WS_PER_SEC=20
